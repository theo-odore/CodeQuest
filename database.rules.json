{
  "rules": {
    ".read": false,
    ".write": false,

    "admin": {
      "allowedUids": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && (root.child('admin/allowedUids').child(auth.uid).val() === true || !root.child('admin/allowedUids').exists())"
        }
      },
      "profiles": {
        ".read": "auth != null && root.child('admin/allowedUids').child(auth.uid).val() === true",
        "$uid": {
          ".write": "auth != null && (root.child('admin/allowedUids').child(auth.uid).val() === true || !root.child('admin/allowedUids').exists())"
        }
      }
    },

    "questions": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admin/allowedUids').child(auth.uid).val() === true"
    },

    "quizState": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admin/allowedUids').child(auth.uid).val() === true"
    },

    "participants": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admin/allowedUids').child(auth.uid).val() === true",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admin/allowedUids').child(auth.uid).val() === true)"
      }
    },

    "leaderboard": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admin/allowedUids').child(auth.uid).val() === true"
    },

    "codeChallenge": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admin/allowedUids').child(auth.uid).val() === true"
    }
  }
}
